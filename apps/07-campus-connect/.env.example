# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the real .env
# ---------------------------------------------------------------------------

# Signs the session cookie. MUST be set in production; a random value is
# generated per boot in development, which logs everyone out on restart.
AUTH_SECRET=

# Leave empty to use the embedded PGlite database at ./data/campus-connect
# (zero config, ideal for local development). Set it to a real PostgreSQL
# connection string for anything shared or deployed — multiple processes
# cannot safely open one PGlite directory at the same time.
DATABASE_URL=

# Override the PGlite data directory.
PGLITE_DATA_DIR=

# --- Outbound notifications (optional) ---------------------------------------
# Leave blank to disable. Nothing is sent unless these are set.
SMTP_URL=
TWILIO_ACCOUNT_SID=
WA_PHONE_NUMBER_ID=
