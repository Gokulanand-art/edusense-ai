{
  "name": "campus-connect",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf ./data/campus-connect && tsx scripts/seed.ts",
    "import:csbs": "tsx scripts/import-csbs.ts",
    "db:reset:csbs": "rm -rf ./data/campus-connect && tsx scripts/seed.ts && tsx scripts/import-csbs.ts --file \"${CSBS_FILE:?set CSBS_FILE to the xlsx path}\" --reset"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.378.0",
    "next": "14.2.3",
    "pg": "^8.11.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
