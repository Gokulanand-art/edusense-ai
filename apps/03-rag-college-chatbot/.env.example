# Database Connection (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/college_rag?schema=public"

# Authentication Secret (NextAuth)
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="super-secret-nextauth-key-change-in-production-123456"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="super-secret-nextauth-key-change-in-production-123456"

# LLM Provider Configuration
# Supported providers: "gemini" | "openai" | "local"
LLM_PROVIDER="gemini"
LLM_API_KEY="your-gemini-or-openai-api-key"
LLM_MODEL="gemini-1.5-flash"
# For OpenAI: LLM_MODEL="gpt-4o-mini"

# Embedding Provider Configuration
# Supported providers: "gemini" | "openai" | "local"
EMBEDDING_PROVIDER="gemini"
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_MODEL="text-embedding-004"
# For OpenAI: EMBEDDING_MODEL="text-embedding-3-small"

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./public/uploads"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

# RAG Hyperparameters
MIN_RELEVANCE_SCORE=0.70
RAG_TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
