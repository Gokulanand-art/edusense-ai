# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — Smart Campus Intelligence System
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
.env.local

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
*.pem
*.key
*.p12
*.pfx
secrets/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.lcov
nosetests.xml
test-results/

# ── Uploads (ephemeral local only — stored in Postgres for production) ────────
uploads/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Node (if ever added) ──────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ── Render / cloud ────────────────────────────────────────────────────────────
.render-buildpacks.yaml
